# Copy this file to .env and fill in whichever keys you actually have.
# Any provider left blank is skipped (reported as "not configured") instead of failing.

PORT=3000

# https://haveibeenpwned.com/API/Key ($3.95/mo). Note: HIBP's phone coverage is
# very limited -- most breaches only carry email addresses, not phone numbers.
HIBP_API_KEY=

# https://wiki.leakcheck.io/en/api -- paid plan required for phone-type lookups.
LEAKCHECK_API_KEY=

# https://dehashed.com/api -- paid credits required.
DEHASHED_API_KEY=
